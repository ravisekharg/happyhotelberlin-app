{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/rooms",          "destination": "/index.html" },
    { "source": "/stay",           "destination": "/index.html" },
    { "source": "/amenities",      "destination": "/index.html" },
    { "source": "/gallery",        "destination": "/index.html" },
    { "source": "/neighbourhood",  "destination": "/index.html" },
    { "source": "/location",       "destination": "/index.html" },
    { "source": "/groups",         "destination": "/index.html" },
    { "source": "/faq",            "destination": "/index.html" },
    { "source": "/book",           "destination": "/index.html" },
    { "source": "/contact",        "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
